{
  "name": "@jojoman2024/dsh-prompt-inject",
  "displayName": "DSH 提示词注入",
  "description": "在会话工具条挂按钮，点击后开新标签页管理提示词；点【注入】可在当前会话下一次模型 step 前注入 prompt 到 system prompt。",
  "version": "0.1.0",
  "author": "jojoman2024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jojoman2024/dsh-prompt-inject.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-inject",
    "system-prompt"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.mjs",
  "types": "lib/host/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/host/index.d.mts",
      "default": "./lib/host/index.mjs"
    },
    "./client": {
      "types": "./lib/client/client.d.ts",
      "default": "./lib/client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.0",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "tsdown": "^0.22.2"
  }
}
